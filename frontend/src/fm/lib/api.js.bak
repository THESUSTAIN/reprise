// Quote cache : la citation du jour ne change pas dans la journée → cache mémoire 1h
// + dedup in-flight (plusieurs composants peuvent appeler en parallèle au mount)
let _quoteCache = { ts: 0, data: null, promise: null };
export const quoteApi = {
  today: async () => {
    const now = Date.now();
    if (_quoteCache.data && (now - _quoteCache.ts) < 60 * 60 * 1000) {
      return _quoteCache.data;
    }
    if (_quoteCache.promise) {
      return _quoteCache.promise;
    }
    _quoteCache.promise = api.get("/api/quote/today")
      .then((data) => {
        _quoteCache = { ts: Date.now(), data, promise: null };
        return data;
      })
      .catch((e) => { _quoteCache.promise = null; throw e; });
    return _quoteCache.promise;
  },
  _resetCache: () => { _quoteCache = { ts: 0, data: null, promise: null }; },
};

export const wpApi = {
  status: () => api.get("/api/wp/status"),
  products: ({ page = 1, perPage = 20, search = "", status = "" } = {}) =>
    api.get(
      `/api/wp/products?per_page=${perPage}&page=${page}` +
        (search ? `&search=${encodeURIComponent(search)}` : "") +
        (status ? `&status=${status}` : "")
    ),
  product: (id) => api.get(`/api/wp/products/${id}`),
  createProduct: (data) => api.post("/api/wp/products", data),
  updateProduct: (id, data) => api.put(`/api/wp/products/${id}`, data),
  deleteProduct: (id, force = false) =>
    api.del(`/api/wp/products/${id}?force=${force ? "true" : "false"}`),
  categories: () => api.get("/api/wp/product-categories"),
  orders: ({ page = 1, perPage = 20, status = "" } = {}) =>
    api.get(
      `/api/wp/orders?per_page=${perPage}&page=${page}` +
        (status ? `&status=${status}` : "")
    ),
  ordersSummary: () => api.get("/api/wp/orders/summary"),
  posts: ({ page = 1, perPage = 10 } = {}) =>
    api.get(`/api/wp/posts?per_page=${perPage}&page=${page}`),
  pages: () => api.get("/api/wp/pages"),
};

// Helper used by Espace pages to identify the current user (or 'guest' fallback)
export const getUserId = () => {
  try {
    const u = JSON.parse(localStorage.getItem('zayado_user') || 'null');
    return u?.id || u?.email || 'guest';
  } catch { return 'guest'; }
};

// ── Finance CSV import ────────────────────────────────────────────────
export const financeApi = {

  /**
   * Prévisualise un fichier CSV sans écrire en base.
   * Retourne { bank_format, will_add, duplicates_skipped, preview_rows, … }
   */
  importCsvPreview: async (file) => {
    const form = new FormData();
    form.append("file", file);
    const res = await fetch(`${api.baseURL || ""}/api/import-csv-v2?preview=true`, {
      method: "POST",
      body: form,
      headers: { Authorization: `Bearer ${localStorage.getItem("zayado_token") || ""}` },
    });
    if (!res.ok) throw new Error((await res.json()).detail || "Erreur prévisualisation CSV");
    return res.json();
  },
  /**
   * Importe réellement le fichier CSV en base.
   */
  importCsv: async (file) => {
    const form = new FormData();
    form.append("file", file);
    const res = await fetch(`${api.baseURL || ""}/api/import-csv-v2`, {
      method: "POST",
      body: form,
      headers: { Authorization: `Bearer ${localStorage.getItem("zayado_token") || ""}` },
    });
    if (!res.ok) throw new Error((await res.json()).detail || "Erreur import CSV");
    return res.json();
  },
};

