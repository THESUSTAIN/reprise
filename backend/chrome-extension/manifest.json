{
  "manifest_version": 3,
  "name": "MyExtension AI — Zayado Copilot",
  "version": "2.1.0",
  "description": "Couche IA contextuelle entre votre navigateur et votre Business OS. Side-panel Hub IA, capture intelligente et CRM.",
  "action": {
    "default_title": "Ouvrir Zayado Copilot",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["activeTab", "storage", "scripting", "contextMenus", "sidePanel"],
  "host_permissions": [
    "https://app.zayado.net/*",
    "https://zayado.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://calendar.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://app.zayado.net/*",
      "https://zayado.net/*"
    ]
  }
}
