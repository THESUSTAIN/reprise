# ─────────────────────────────────────────────────────────────
# Zayado API — variables d'environnement (backend)
# Copier ce fichier en ".env" et compléter les valeurs manquantes.
# Ne JAMAIS committer le ".env" réel (secrets).
# ─────────────────────────────────────────────────────────────

ENV=production
NODE_ENV=production

# ── Secrets applicatifs — NE JAMAIS committer de vraie valeur ici ──
# Générer les vôtres et les définir UNIQUEMENT dans le .env local / les
# Variables Railway (jamais dans ce fichier d'exemple versionné) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=changeme-generate-a-48-char-random-secret
FERNET_KEY=changeme-generate-a-fernet-key

# ── Base de données (MySQL en prod, SQLite en local si vide) ──
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── URLs publiques ──
FRONTEND_URL=https://app.zayado.net
REACT_APP_BACKEND_URL=https://api.zayado.net
PUBLIC_FRONTEND_URL=https://app.zayado.net
CORS_ORIGINS=https://app.zayado.net,https://www.zayado.net,https://zayado.net

# ── OAuth Google (Google Cloud Console > Identifiants) ──
# Redirect URI à autoriser côté Google : {FRONTEND_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth Microsoft (Azure App registrations) ──
# Redirect URI à autoriser côté Azure : {FRONTEND_URL}/auth/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Web Push (VAPID) — paire de clés générée pour vous dans backend/keys/ ──
VAPID_PUBLIC_KEY=BDfkM9iui0ei7KEJZ3rwBo48pBQjAqhQG9davHQJcuZVJr8zknCgVD7WftKRZZmXI595Q2LdV3Vpq_udhd_tIrE
VAPID_PRIVATE_KEY_PATH=keys/private_key.pem
VAPID_SUBJECT=mailto:hello@zayado.net

# ── Email transactionnel (Brevo) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Zayado

# ── IA ──
EMERGENT_LLM_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
# Fallback global si l'App Secret n'est pas renseigné dans la connexion WhatsApp de l'agent (UI).
# Sert a valider la signature X-Hub-Signature-256 des webhooks entrants (HMAC-SHA256).
# Sans cette valeur (ni au niveau agent, ni ici), les webhooks sont acceptes SANS verification (mode dev).
WA_APP_SECRET=
# Secret partage avec le microservice WhatsApp Web (whatsapp-web.js), verifie via le header x-service-secret
WA_SERVICE_SECRET=
# URL interne/publique du microservice Railway WhatsApp Web
WA_SERVICE_URL=
# Alias utilisé par certaines automatisations
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_SECRET=

# --- Mammoth IA (proxy unifie Claude/GPT/Gemini) ---
MAMMOTH_API_KEY=

# --- Vision Board : recherche de photos (deja code, il ne manque que la cle) ---
# Sans cette cle, /api/vision-board/photos retombe sur une selection curee statique.
UNSPLASH_ACCESS_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Paiement (Mollie) ──
MOLLIE_API_KEY=

# ── WordPress (si intégration) ──
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WP_WEBHOOK_SECRET=

# ── Divers ──
ALLOW_GUEST_LOGIN=true
ADMIN_RESET_SECRET=
